{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run src/shared/db/database.integration.test.ts src/modules/auth/auth.integration.test.ts src/modules/inventory/inventory.integration.test.ts src/modules/migration/legacy-products.integration.test.ts src/modules/sales/sales.integration.test.ts src/modules/purchases/purchases.integration.test.ts src/modules/customer-orders/customer-orders.integration.test.ts src/modules/reports/financial.integration.test.ts",
    "test:coverage:all": "vitest run --coverage",
    "test:coverage": "vitest run --coverage --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.8.1",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.21.0",
    "vitest": "4.1.11"
  }
}
